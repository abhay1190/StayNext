<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayNexa</title>
</head>
<body>
    <h2>Edit Your Listing</h2>
    <form method="post" action="/listings/<%= listing.id %>?_method=PUT">
        <input type="text" value="<%= listing.title %>" name="listing[title]" required>
        <br><br>
        <textarea name="listing[description]" required><%= listing.description %></textarea>
        <br><br>
        <input type="text" value="<%= listing.image %>" name="listing[image]">
        <br><br>
        <input type="number" value="<%= listing.price %>" name="listing[price]" required>
        <br><br>
        <input type="text" value="<%= listing.location %>" name="listing[location]" required>
        <br><br>
        <input type="text" value="<%= listing.country %>" name="listing[country]" required>
        <br><br>
        <button>Edit</button>
    </form>
</body>
</html>